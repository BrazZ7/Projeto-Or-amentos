# Porta do servidor de desenvolvimento (npm run dev). Deixe comentado para usar
# a 3000. Se mudar aqui, ajuste também NEXTAUTH_URL e NEXT_PUBLIC_APP_URL abaixo.
# PORT="3000"

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orcafacil?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-gerado-com-openssl-rand-base64-32"

# URL pública da aplicação (usada em links de orçamento, e-mails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail (SMTP) - usado para verificação de conta, recuperação de senha e envio de orçamentos
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="usuario@exemplo.com"
SMTP_PASSWORD="senha"
SMTP_FROM="OrcaFacil <naoresponda@orcafacil.com>"

# Inteligência artificial (Claude / Anthropic) - usado para os recursos de IA
ANTHROPIC_API_KEY=""

# Pagamentos / assinaturas (Stripe) - usado no módulo de planos
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
